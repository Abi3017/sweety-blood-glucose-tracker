{
  "name": "sweety-backend",
  "version": "1.0.0",
  "description": "Sweety – Blood Glucose Tracker REST API (Express + Prisma + PostgreSQL)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "test": "node --env-file=.env.test node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --env-file=.env.test node_modules/jest/bin/jest.js --runInBand --coverage"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000,
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2"
  }
}
