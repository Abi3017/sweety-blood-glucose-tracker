# ---------- Backend (copy to backend/.env) ----------
# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sweety_dev?schema=public"
# For backend tests, create backend/.env.test with the same keys, NODE_ENV="test"
# and a DATABASE_URL pointing to a separate database whose name contains "test".
# Long random string used to sign JWTs, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"
# Token lifetime (jsonwebtoken format, e.g. 1d, 12h)
JWT_EXPIRES_IN="1d"
# Port the API listens on
PORT=5000
# Origin of the React app (used for CORS)
CLIENT_URL="http://localhost:5173"
# development | test | production
NODE_ENV="development"
# IANA time zone used to decide what "today" is (future-date rule, default report dates)
APP_TIMEZONE="Asia/Kolkata"
# Optional. Defaults to true when NODE_ENV=production. Set false only for local HTTP (e.g. Docker on localhost).
COOKIE_SECURE=

# ---------- Frontend (copy to frontend/.env) ----------
# Base URL of the API. Leave as /api when using the Vite dev proxy.
VITE_API_URL="/api"
